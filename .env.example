# Database URL (SQLite default for instant zero-dependency local dev; PostgreSQL supported)
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/loop_db?schema=public"

# NextAuth Secret
NEXTAUTH_SECRET="your-generated-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic Claude API (Sonnet 4.6)
# Standard Anthropic Key format: sk-ant-api03-... (Get live keys at: https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-api03-loop-demo-preview-key-2026"
